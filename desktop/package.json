{
  "name": "analiz-istorii",
  "version": "1.3.2",
  "private": true,
  "description": "Анализ работы отделения — Electron UI",
  "author": "Analiz_istorii",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RUN_AS_NODE= ANALIZ_DEVTOOLS=1 VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "backend": "bash scripts/build-backend.sh",
    "backend:win": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "dist:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "dist:all": "npm run backend && npm run dist:win"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.analiz.istorii",
    "productName": "AnalizIstorii",
    "copyright": "Copyright © Analiz_istorii",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "extraFiles": [
      {
        "from": "../version.txt",
        "to": "version.txt"
      },
      {
        "from": "../KSGoperacii.csv",
        "to": "KSGoperacii.csv"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
